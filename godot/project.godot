; Collapsible Time - The Last Flight
; Godot 4 project. Uses Compatibility renderer for older hardware.
config_version=5

[application]
config/name="COLLAPSIBLE TIME: THE LAST FLIGHT"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.18, 0.25, 0.29, 1)
